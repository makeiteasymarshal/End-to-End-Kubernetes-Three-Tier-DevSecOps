# Application
APP_NAME=three-tier-devsecops-api
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Database (Local PostgreSQL or SQLite for unit tests)
# Example PostgreSQL: postgresql://postgres:CHANGE_ME@localhost:5432/threetierdb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=threetierdb
DB_USER=appuser
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://appuser:CHANGE_ME_LOCAL_ONLY@localhost:5432/threetierdb

# Frontend
VITE_API_BASE_URL=/api/v1

# AWS (Placeholders only - never commit real values)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
EKS_CLUSTER_NAME=three-tier-devsecops-eks
ECR_BACKEND_REPO=three-tier-backend
ECR_FRONTEND_REPO=three-tier-frontend
